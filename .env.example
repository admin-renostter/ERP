# ═══════════════════════════════════════════════════════════════════
# Renostter CRM — Environment Variables
# Sprint 22 — Fase 0 (Docker + Postgres + Redis)
#
# Copie para .env e ajuste antes de subir o docker compose:
#   cp .env.example .env
#
# NUNCA commite o .env (já está no .gitignore e .dockerignore)
# ═══════════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Database (Postgres 16) ──
DB_DRIVER=postgres
POSTGRES_USER=renostter
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA_FORTE_a1b2c3d4e5
POSTGRES_DB=renostter_crm
# DATABASE_URL é montado automaticamente pelo docker-compose
# Para rodar fora do Docker, descomente:
# DATABASE_URL=postgresql://renostter:senha@localhost:5432/renostter_crm
PGSSLMODE=disable
PG_POOL_MAX=10

# Redis 7 (cache + fila)
REDIS_PASSWORD=ALTERE_OUTRA_SENHA_FORTE_f6g7h8i9j0
# REDIS_URL=redis://localhost:6379 (built automaticamente)

# ── Segurança ──
# JWT — gere um novo secret: openssl rand -hex 64
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI_64_CHARS_HEXADECIMAL_0123456789abcdef
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d

# Criptografia DB (32 bytes exatos — AES-256-GCM)
# Gere: openssl rand -base64 32
DB_ENCRYPTION_KEY=ALTERE_ESTA_CHAVE_32_BYTES_BASE64_PRECISA_SER_32

# CORS (origens permitidas separadas por vírgula)
CORS_ORIGIN=http://localhost,http://localhost:3000,http://localhost:5500,http://localhost:8080

# Auth mode: 'jwt' (prod), 'dual' (transição), 'legacy' (NÃO USAR)
AUTH_MODE=dual

# ── Empresa ──
COMPANY_NAME=Renostter Climatização
COMPANY_CNPJ=11.222.333/0001-44
COMPANY_ADDRESS=Av. Brasil, 1000
COMPANY_CITY=São Paulo
COMPANY_STATE=SP

# ── Cora Gateway (mTLS) ──
# Crie o app no painel Cora → credenciais → certificados
CORA_ENV=production
CORA_CLIENT_ID=int-3cR3yfHHjtuXNW5bmX6mhN
CORA_CERT_PATH=/app/certs/cora/certificate.pem
CORA_KEY_PATH=/app/certs/cora/private-key.key
# Force MOCK em dev (true = nunca chama Cora real)
CORAFORCE_MOCK=true

# ── Autentique (assinatura digital) ──
# Deixe vazio para MODO MOCK (não envia nada real)
# AUTENTIQUE_ENDPOINT=https://api.autentique.com.br/v2/graphql
# AUTENTIQUE_TOKEN=seu-token-do-painel
# AUTENTIQUE_WEBHOOK_SECRET=secret-configurado-no-painel
# AUTENTIQUE_SANDBOX=true

# ── E-mail transacional ──
# Resend (recomendado) — https://resend.com
RESEND_API_KEY=re_ALTERE_ESTA_CHAVE_API
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Renostter <noreply@renostter.com.br>

# ── Stripe (billing SaaS) ──
# Quando ativar Fase 1 — Comercial
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Backblaze B2 (storage S3-compatible) ──
# Quando ativar Fase 3 — Storage
# BACKBLAZE_KEY_ID=
# BACKBLAZE_APP_KEY=
# BACKBLAZE_BUCKET=renostter-uploads
# BACKBLAZE_ENDPOINT=s3.us-west-002.backblazeb2.com

# ── UAZAPI / Luniochat (WhatsApp) ──
# Quando ativar Fase 1.1 — Integração WhatsApp
# UAZAPI_TOKEN=
# UAZAPI_BASE_URL=https://uazapi.com
# UAZAPI_INSTANCE_ID=

# ── OpenClaw (clawd.bot — agentes IA) ──
# Quando ativar Fase 2 — IA-First
# OPENCLAW_API_KEY=
# OPENCLAW_BASE_URL=https://api.clawd.bot

# ── Anthropic (Claude API para MCP server) ──
# Quando ativar Fase 2 — IA-First
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cron / Lembretes ──
CRON_SCHEDULE=0 3 * * *
CRON_TZ=America/Sao_Paulo

# ── Logs ──
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=/app/logs

# ── Rate limit (por IP) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5

# ── Backups ──
BACKUP_ENCRYPTION_KEY=GERE_OUTRA_CHAVE_32_BYTES_PARA_BACKUPS_CIFRADOS
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_KEY_ID=
BACKUP_S3_APP_KEY=

# ── LGPD ──
LGPD_DPO_EMAIL=dpo@renostter.com.br
LGPD_RETENTION_YEARS=5
LGPD_AUDIT_RETENTION_YEARS=2

# ── Multi-tenant ──
DEFAULT_TENANT_ID=tnt_default
TENANT_DEFAULT_PLAN=starter
ENABLE_MULTI_TENANT=true

# ── Feature flags ──
ENABLE_AI_AGENTS=false
ENABLE_MCP_SERVER=true
ENABLE_WHATSAPP_WEBHOOK=false
ENABLE_MOBILE_API=true
ENABLE_PORTAL=true

# ── Sprint Security Infra — Firewall/WAF/EDR+SIEM ──
# Cloudflare API (usado por scripts/cloudflare-waf-setup.sh e
# scripts/update-cloudflare-realip.sh). Gere um token em
# dash.cloudflare.com → My Profile → API Tokens (escopo restrito à
# zona renostter.com). NUNCA commite o valor real — só em .env.
CF_API_TOKEN=
CF_ZONE_ID=

# Wazuh (EDR+SIEM) — ver scripts/setup-wazuh.sh,
# docker-compose.wazuh-agent.yml e scripts/install-wazuh-agent-host.sh
WAZUH_MANAGER_HOST=host.docker.internal
WAZUH_MANAGER_IP=127.0.0.1
WAZUH_REGISTRATION_PASSWORD=GERE_UMA_SENHA_FORTE_PARA_REGISTRO_DE_AGENTES
