{
  "name": "cora-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test.js",
    "smoke": "node scripts/smoke-test.js",
    "test:mcp": "node scripts/test-mcp.js",
    "test:sprint8": "node scripts/test-sprint8.js",
    "verify:sprint0": "node scripts/verify-sprint0.js",
    "seed:users": "node scripts/seed-users.js",
    "rotate:check": "node scripts/rotate-secrets.js --check",
    "rotate:db": "node scripts/rotate-secrets.js --gen db-encryption",
    "rotate:jwt": "node scripts/rotate-secrets.js --gen jwt-secret",
    "rotate:webhook": "node scripts/rotate-secrets.js --gen webhook-secret",
    "rotate:autentique": "node -e \"console.log('AUTENTIQUE_TOKEN=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "rotate:resend": "node -e \"console.log('RESEND_API_KEY=re_' + require('crypto').randomBytes(32).toString('base64url'))\"",
    "reminders:daily": "node -e \"require('./services/ReminderService').runDaily().then(r => console.log(JSON.stringify(r, null, 2)))\"",
    "cron:start": "node -e \"require('./jobs/dailyReminders').start()\"",
    "templates:seed": "node scripts/test-sprint11.js",
    "icp:test": "node scripts/test-sprint10.js"
  },
  "keywords": [
    "cora",
    "boleto",
    "crm",
    "renostter"
  ],
  "author": "Renostter",
  "license": "ISC",
  "description": "Microserviço de integração CRM Renostter ↔ API Cora (mTLS, Webhooks, Boletos)",
  "dependencies": {
    "@expo/pkcs12": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.1",
    "nodemailer": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "redis": "^3.1.2",
    "speakeasy": "^2.0.0",
    "sqlite3": "^6.0.1",
    "uuid": "^13.0.0"
  }
}
