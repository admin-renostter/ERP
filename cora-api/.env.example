# ═══════════════════════════════════════════════════════════════════════════
# Renostter CRM — Variáveis de Ambiente (EXEMPLO)
# ═══════════════════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha cada variável (não commite o .env!)
#   3. Em produção, use um secrets manager (Vault, AWS SM, Doppler, etc.)
#
# Em produção, TODAS as variáveis marcadas com [PROD] são OBRIGATÓRIAS.
# Se faltar alguma, o servidor NÃO inicia (fail-fast).
#
# ═══════════════════════════════════════════════════════════════════════════

# ─── Ambiente ───────────────────────────────────────────────────────────
NODE_ENV=development  # 'development' | 'production' | 'staging'

# ─── Banco de dados ─────────────────────────────────────────────────────
DB_DRIVER=sqlite
# DB_PATH=./cora.sqlite
# Para Postgres, defina DATABASE_URL ou PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# DATABASE_URL=postgresql://user:pass@localhost:5432/renostter
# PGSSLMODE=require

# ─── Criptografia [PROD] ───────────────────────────────────────────────
# AES-256-GCM. NUNCA use o valor padrão em produção.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# ─── Autenticação JWT [PROD] ───────────────────────────────────────────
# HMAC-SHA256/512. Mínimo 32 bytes. Rotacione com cuidado (invalida tokens).
# Para gerar: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_ALGO=HS256
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# Modo de auth: 'jwt' (padrão prod), 'dual' (transição), 'legacy' (dev only)
AUTH_MODE=

# ─── Webhooks Cora [PROD] ──────────────────────────────────────────────
# Secret compartilhado com a Cora para assinatura HMAC-SHA256 dos webhooks.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_WEBHOOK_SECRET=

# CUIDADO: bypass só para testes E2E locais. NUNCA ativar em prod.
# WEBHOOK_SIGNATURE_BYPASS=false

# ─── Cora (mTLS) [PROD] ───────────────────────────────────────────────
CORA_CLIENT_ID=
# Caminhos absolutos dos certificados mTLS. Preferencialmente FORA do projeto.
CORA_CERT_PATH=/etc/renostter/cora/certificate.pem
CORA_KEY_PATH=/etc/renostter/cora/private-key.key
CORA_BASE_URL=https://matls-clients.api.cora.com.br

# ─── Itaú (mTLS opcional) ──────────────────────────────────────────────
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_BASE_URL=https://api.itau.com.br

# ─── SMTP (e-mail) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Renostter CRM <noreply@renostter.com>"

# ─── WhatsApp (Sprint 9 — UAZAPI/Z-API/Twilio) ───────────────────────
# Provider: uazapi (BR, padrão) | zapi (BR) | twilio (internacional) | mock (dev)
WHATSAPP_PROVIDER=uazapi
# Para UAZAPI: token de API
WHATSAPP_TOKEN=
# Para Z-API: instance + token (ambos necessários)
WHATSAPP_INSTANCE=
WHATSAPP_BASE_URL=https://api.uazapi.com
# Número de origem (DDI+DDD+Número) — Renostter
WHATSAPP_FROM=5511952730593
# Para Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# ─── Lembretes automáticos (Sprint 9) ───────────────────────────────
# 'true' (default) ou 'false' para desabilitar o cron
REMINDERS_CRON_ENABLED=true
REMINDERS_HOUR=8
TZ=America/Sao_Paulo

# ─── Frontend / CORS [PROD] ────────────────────────────────────────────
# Lista de origens separadas por vírgula. Em prod, NUNCA use "*".
CRM_FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080

# ─── Mocks (dev only) ──────────────────────────────────────────────────
# Em prod, mocks são PROIBIDOS — o servidor falha o boot se ALLOW_MOCK=true.
# ALLOW_MOCK=true

# ─── Seed (apenas primeira execução) ───────────────────────────────────
# Senha usada pelo scripts/seed-users.js. DEVE ser sobrescrita em prod.
# SEED_PASSWORD=

# ─── MCP (Sprint 6 — Model Context Protocol) ──────────────────────────
# Token de service account para OpenClaw e outros clientes MCP.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SERVICE_TOKEN=

# ─── LLM (Sprint 6 — Claude/GPT) ──────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_DAILY_BUDGET_USD=10.00

# Embeddings (RAG)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.65

# ─── Email Transacional (Sprint 8 — Resend) ─────────────────────────
# Criar conta em https://resend.com → API Keys
# Para gerar: https://resend.com/api-keys
RESEND_API_KEY=
# Remetente (em dev, usa onboarding@resend.dev — só envia pra você mesmo)
# Em prod, configure um domínio (renostter.com.br) e use noreply@renostter.com.br
RESEND_FROM="Renostter CRM <onboarding@resend.dev>"
RESEND_REPLY_TO=suporte@renostter.com.br

# ─── Assinatura Digital (Sprint 8 — Autentique) ──────────────────────
# API token do painel: https://painel.autentique.com.br/perfil/api
# Custos: criar doc R$ 0,06 + signatário email R$ 0,013
# Free tier: 20 docs/mês (10 via API). Profissional: R$ 99/mês ilimitado
AUTENTIQUE_TOKEN=
# Pasta padrão onde salvar envelopes (opcional, UUID)
# AUTENTIQUE_FOLDER_ID=
# Em dev, sempre sandbox=true (não conta na fatura)
# AUTENTIQUE_SANDBOX=true
# Secret do webhook (HMAC-SHA256)
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTENTIQUE_WEBHOOK_SECRET=

# ─── Engine de PDF (Sprint 8) ─────────────────────────────────────────
# 'auto' (padrão) | 'puppeteer' | 'pdf-lib' | 'minimal'
# puppeteer = melhor renderização, mas precisa de Chromium
# pdf-lib = puro JS, sem deps, qualidade básica
# minimal = fallback, PDF mínimo sem formatação
PDF_ENGINE=auto

# ─── Port ──────────────────────────────────────────────────────────────
PORT=3000
