FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    curl \
    docker-compose \
    && rm -rf /var/lib/apt/lists/*

RUN echo "Flask==3.0.0" > requirements.txt && \
    echo "Werkzeug==3.0.0" >> requirements.txt && \
    echo "gunicorn==21.2.0" >> requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/webhook-deploy.py /app/webhook-deploy.py

RUN mkdir -p /var/log/webhook-deploy

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:5000", "--timeout", "60", "webhook-deploy:app"]
